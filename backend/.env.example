# Postgres (local via `docker compose up postgres -d`, ou a connection string do Supabase em produção)
# Porta 5433 no host para não colidir com um PostgreSQL nativo na 5432 (comum no Windows)
DATABASE_URL="postgresql://erp:erp@localhost:5433/erp"
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
PDV_URL="http://localhost:5174"
# Origens extras permitidas por CORS, separadas por vírgula (ex: domínios do Vercel)
EXTRA_ALLOWED_ORIGINS=
